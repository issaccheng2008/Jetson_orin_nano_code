# Trusted Bash configuration. The installer creates config/remote_start.env (0600).
REPO_DIR="${REMOTE_REPO_DIR}"
POLICY_PYTHON="$HOME/venvs/humanoid_policy/bin/python"
WALKING_MODEL="$REPO_DIR/humanoid_jetson_deploy/policy(13).onnx"
STM32_PORT=/dev/ttyACM0
REMOTE_BIND=0.0.0.0
REMOTE_PORT=8080
POLICY_PORT=5007
POLICY_STARTUP_TIMEOUT=20
MAX_VX=0.4
MAX_WZ=0.5
POLICY_STEP_CM=''
POLICY_KP_SCALE=1
POLICY_KD_SCALE=1
# Generated once by the installer. Never place the token in a command or URL.
ROBOT_REMOTE_TOKEN=''
