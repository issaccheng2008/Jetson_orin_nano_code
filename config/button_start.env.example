REPO_DIR="${BUTTON_REPO_DIR}"
VISION_PYTHON="$REPO_DIR/.venv/bin/python"
POLICY_PYTHON="$HOME/venvs/humanoid_policy/bin/python"
# This file is sourced by Bash. Quote paths containing spaces. Keep it user-owned.
# The installer writes concrete paths for the three settings above.
WALKING_MODEL="$REPO_DIR/humanoid_jetson_deploy/policy_49_max.onnx"
ONE_FOOT_MODEL="$REPO_DIR/humanoid_jetson_deploy/policy-one-foot-standing_old.onnx"
STM32_PORT=/dev/ttyACM0
CAMERA=0
# Optional startup camera hardware controls; keep/empty leaves its current state alone.
CAMERA_EXPOSURE_MODE=keep # keep, auto, manual. Manual requires CAMERA_EXPOSURE_MS.
CAMERA_EXPOSURE_MS='' # Milliseconds, 0.1 ms steps. Use 5 with manual mode for the tested setting.
CAMERA_BRIGHTNESS=''
CAMERA_CONTRAST=''
CAMERA_SATURATION=''
CAMERA_SHARPNESS=''
CAMERA_WHITE_BALANCE_MODE=keep # keep, auto, manual. Manual requires Kelvin below.
CAMERA_WHITE_BALANCE_K=''
CAMERA_POWER_LINE_HZ='' # Empty preserves; 50 or 60 Hz, 0 disables anti-flicker.
VX=0.2
WZ_MODE=heading # heading or segments (plural); matches --wz-mode
LINE_PREPROCESS=legacy # previous mask, with reference-normalized adaptive C
LINE_ADAPTIVE_C=-12 # reference C; actual C = reference C * current_std/reference_std
SHAPE_PREPROCESS=selective # canny: experimental filled fine-stroke candidates
PHOTOMETRIC_MODE=normalize # reference mean/std gates; legacy: former fixed gates
LOST_HOLD_S=0.2 # Legacy loss mode only; history-turn uses STEERING_LOSS_MAX_S below.
# Actual walking model input hold; 0 = no hold, 0.5 = original half-second contract.
# Legacy policy hold only; auto-launched policy uses 0 when the vision window is enabled.
COMMAND_MIN_HOLD_S=0
STEERING_COMMAND_WINDOW_S=0.5 # Median of all valid mapped frame commands per window; 0 disables.
STEERING_COMMAND_MEDIAN=lower # lower or upper; even count never averages discrete values.
STEERING_LOSS_FALLBACK_WZ=0.3 # Positive left, negative right, 0 straight; rad/s, clipped to steering caps.
STARTUP_FIRST_WALK_S=0.5 # Initial straight walk before executing a first card latched before button start; >0.
STARTUP_SEQUENCE='' # Empty uses STARTUP_FIRST_WALK_S and VX; nonempty JSON overrides them for the initial sequence.
# Example: straight 0.5s, then left turn 0.5s, then execute first card:
# STARTUP_SEQUENCE='[{"duration_s":0.5,"vx":0.2,"wz":0},{"duration_s":0.5,"vx":0.2,"wz":0.5}]'
# legacy = original steering; shadow = compare in logs; active = apply smoothing/hysteresis.
STEERING_FILTER_MODE=active
# robust = median/fixed EMA/slew; one-euro = adaptive; ema = fixed cutoff; none = original median.
STEERING_FILTER_ALGORITHM=robust
STEERING_FILTER_ROBUST_TAU_S=0.45
STEERING_FILTER_ROBUST_WINDOW_S=0.6
STEERING_FILTER_ROBUST_SLEW_DEG_S=45
STEERING_LOSS_MODE=history-turn # history-stop remains a compatible alias; neither stops on lane loss.
STEERING_LOSS_MAX_S=0.8 # Maximum old-turn reuse; then keep VX and use STEERING_LOSS_FALLBACK_WZ.
STEERING_LOSS_HISTORY_S=0.8
STEERING_SEGMENT_FALLBACK=1
STEERING_FILTER_MIN_HZ=1.5 # Smaller = more smoothing and lag; main strength knob.
STEERING_FILTER_MAX_HZ=4
STEERING_FILTER_BETA=0.03 # Larger = faster following of changes; units: degrees.
STEERING_FILTER_DERIVATIVE_HZ=1
STEERING_FILTER_POSITION_TAU_S=0.1
STEERING_HYSTERESIS_DEG=1 # Half-band between yaw levels; 0 = no band.
STEERING_ENTER_DEG=2
STEERING_EXIT_DEG=1
MAX_WZ=0.5
WZ_BIAS=0 # Compensation disabled. Nonzero opts in to yaw offset; stops stay zero.
WZ_STEP=0.3 # heading/segments cap: use 0.5 to allow the higher yaw levels.
HEADING_LOOKAHEAD_CM=50
HEADING_REGIONS_CM='[[24,26],[28,30]]' # Near/far intervals in cm; each samples eight rows. Far representative ~29cm.
# Older HEADING_NEAR_CM / HEADING_FAR_CM settings apply only when HEADING_REGIONS_CM is empty/missing.
# [start_deg,end_deg,signed_wz_rad_s], using signed filtered final demand + position correction.
# Cover -90 to +90. Example: '[[-90,-3,-0.2],[-3,0,-0.1],[0,10,0.1],[10,90,0.3]]'
# Empty preserves original mapping. [start,end) boundaries; yaw-sign maps wire direction.
# Zero degrees uses its configured rate, which may be positive, negative or zero.
# Set STEERING_HYSTERESIS_DEG=0 for exact boundaries. Protection may override the table.
# Set WZ_STEP=0.5 before using 0.4/0.5 in this table. Edit then restart vision.
STEERING_ANGLE_WZ_TABLE=''
# Array length selects number of regions (2–5); contiguous >=6cm regions within 20–70cm.
# First region must include the near point. No extra scan passes are added.
SEGMENT_REGIONS_CM='[[20,32],[32,44],[44,56]]'
HEADING_CORRIDOR_CM=5
HEADING_RIGHT_TOLERANCE_DEG=9
HEADING_LEFT_TOLERANCE_DEG=4
HEADING_FULL_SCALE_DEG=15
HEADING_LEFT_WZ="0.3 0.4 0.5"
# Independent near-lane position correction in heading/segments; missing fields use these defaults.
POSITION_GAIN=1
POSITION_DEAD_CM=2
POSITION_LOOKAHEAD_CM=50
POSITION_MAX_DEG=12
POSITION_RECOVERY_CM=8
POSITION_RECOVERY_FULL_SCALE_CM=12
POSITION_CONFIRM_FRAMES=2
# Set both POSITION_GAIN and POSITION_RECOVERY_CM to 0 to restore the previous decisions.
CARD_TRIGGER_DIST_CM=30
SHAPE_EVERY=2
RECORD_VIDEO=1 # Selected image source + command arrows; 0 disables. Existing configs default to 1.
VIDEO_SOURCE=bird_pair # bird_pair: BGR birdseye left + final binary right; binary: mask only; camera: original frames.
VIDEO_FPS=10 # Playback FPS (timestamp resampling), not camera or command frequency.
VIDEO_WIDTH=960 # Recording only; detector still uses its original resolution.
POLICY_MAX_SECONDS=1200
# Logs/dumps belong to the repository's ignored records directory.
RECORDS_DIR="$REPO_DIR/records"
