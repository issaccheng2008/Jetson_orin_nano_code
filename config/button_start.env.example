REPO_DIR="${BUTTON_REPO_DIR}"
VISION_PYTHON="$REPO_DIR/.venv/bin/python"
POLICY_PYTHON="$HOME/venvs/humanoid_policy/bin/python"
# This file is sourced by Bash. Quote paths containing spaces. Keep it user-owned.
# The installer writes concrete paths for the three settings above.
WALKING_MODEL="$REPO_DIR/humanoid_jetson_deploy/policy_49_max.onnx"
ONE_FOOT_MODEL="$REPO_DIR/humanoid_jetson_deploy/policy-one-foot-standing_old.onnx"
STM32_PORT=/dev/ttyACM0
CAMERA=0
VX=0.2
MAX_WZ=0.5
WZ_STEP=0.3
HEADING_LOOKAHEAD_CM=50
HEADING_CORRIDOR_CM=5
HEADING_RIGHT_TOLERANCE_DEG=9
HEADING_LEFT_TOLERANCE_DEG=4
HEADING_FULL_SCALE_DEG=15
HEADING_LEFT_WZ="0.3 0.4 0.5"
CARD_TRIGGER_DIST_CM=30
SHAPE_EVERY=2
POLICY_MAX_SECONDS=1200
# Logs/dumps belong to the repository's ignored records directory.
RECORDS_DIR="$REPO_DIR/records"
